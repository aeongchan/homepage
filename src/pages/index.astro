---
import { Image } from "astro:assets"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { SITE } from "@/consts"
---

<Layout>
  <MetaPage slot="head" />
  <dictionary-entry>
    <author>
      <Image
        src={SITE.author.imageUrl}
        alt={SITE.author.name}
        width="64"
        height="64"
      />
    </author>
    <h1>aeong</h1>
    <etymology-span> nothing to say here </etymology-span>
    <hr>
    <prose-content>
      <p>주로 정보글 같은걸 올릴것 같습니다 아마도</p>
      <p>
        <a
          href="https://osu.ppy.sh/users/14709263"
          target="_blank"
          rel="noopener noreferrer"
          >osu!</a
        >
        |
        <a
          href="https://vrchat.com/home/user/usr_3a5ad830-93e3-4df1-9bcb-8fbfd41f980c"
          target="_blank"
          rel="noopener noreferrer"
          >VRChat</a
        >
        |
        <a
          href="https://discord.com/users/548821619661864962"
          target="_blank"
          rel="noopener noreferrer"
          >Discord</a
        >
      </p>
    </prose-content>
  </dictionary-entry>
</Layout>

<style>
  dictionary-entry {
    display: block;
    font-size: var(--step-0);
    color: var(--muted-foreground);

    @media (width >= 64rem) {
      margin-block-start: -0.2em;
    }

    ipa-span {
      opacity: 0.6;
    }

    author {
      img {
        flex-shrink: 0;
        border-radius: var(--radius-full);
      }
    }

    h1 {
      font-size: var(--step-2);
      line-height: calc(var(--leading-offset) + 1em);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      margin-block-end: var(--space-2xs);
    }

    ol {
      margin-block-start: var(--space-xs);
      list-style: none;

      li {
        padding-inline-start: 1em;
        text-indent: -1em;

        &::before {
          content: counter(list-item);
          display: inline-block;
          inline-size: 1em;
          text-indent: 0;
          font-weight: var(--font-weight-medium);
        }

        + li {
          margin-block-start: var(--space-3xs);
        }
      }
    }

    hr {
      margin-block: var(--space-m);
      border-block-start: 2px solid var(--border);
    }

    prose-content {
      margin-block-start: var(--space-xs);
    }
  }
</style>
