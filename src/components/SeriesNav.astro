---
import type { CollectionEntry } from "astro:content"

type Post = CollectionEntry<"posts">
type Props = { prev?: Post; next?: Post }

const { prev, next } = Astro.props
---

{(prev || next) && (
  <series-nav aria-label="Series navigation">
    {prev ? (
      <a href={`/posts/${prev.id}`} rel="prev">
        <span>Previous in series</span>
        <span data-title>{prev.data.title}</span>
      </a>
    ) : (
      <span></span>
    )}
    {next && (
      <a href={`/posts/${next.id}`} rel="next" data-dir="next">
        <span>Next in series</span>
        <span data-title>{next.data.title}</span>
      </a>
    )}
  </series-nav>
)}

<style>
  series-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-s);
    border-block-start: 1px solid var(--border);

    a {
      display: flex;
      flex-direction: column;
      gap: var(--space-3xs);
      min-inline-size: 0;
      font-size: var(--step--1);
      color: var(--muted-foreground);

      &:hover {
        color: var(--foreground);
      }

      &[data-dir="next"] {
        grid-column: 2;
        text-align: end;
      }

      [data-title] {
        color: var(--foreground);
        line-height: calc(var(--leading-offset) + 1em);
      }
    }
  }
</style>
